<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MlvDrive.Core\MlvDrive.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to the WinFsp release the installer installs (2.1.25156). -->
    <PackageReference Include="winfsp.net" Version="2.1.25156" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MLVDrive</AssemblyName>
    <RootNamespace>MlvDrive.Windows</RootNamespace>
    <Product>MLV Drive</Product>
    <Description>Shows Magic Lantern MLV clips as CinemaDNG on a virtual drive for DaVinci Resolve.</Description>
    <!-- Publishing: one self-contained exe, no .NET install needed on the user's PC.
         win-x64 unless publishing with -r win-arm64. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- WinFsp's .NET layer checks its own file version at startup (FileVersionInfo of its
       Assembly.Location), which is empty inside a single-file bundle. Ship it beside the exe. -->
  <Target Name="KeepWinFspBesideExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'winfsp-msil'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
