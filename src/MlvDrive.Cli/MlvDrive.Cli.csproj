<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MlvDrive.Core\MlvDrive.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mlvdrive-cli</AssemblyName>
    <RootNamespace>MlvDrive.Cli</RootNamespace>
    <Product>MLV Drive</Product>
    <!-- no ICU dependency: the app has no culture-sensitive text -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publishing: one small file, no .NET install needed. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <!-- Not on Apple Silicon: .NET 8 loads a compressed bundle's precompiled code into memory that macOS
         sometimes leaves non-executable, so a cold start under parallel reads (Resolve importing a folder)
         dies with an AccessViolationException somewhere different each time. Fixed only in .NET 10.0.13
         and 11: dotnet/runtime issue 123324, PR 127355. -->
    <EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != 'osx-arm64'">true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
